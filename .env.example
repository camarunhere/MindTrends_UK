FLASK_SECRET_KEY=change-this-to-a-random-secret
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mindtrends_uk

# Data retrieval
TRENDS_MODE=auto          # auto | live | simulated
TRENDS_CACHE_TTL_MINUTES=60
TRENDS_REQUEST_TIMEOUT=15

# Seed admin account (created on first run if no admin exists)
ADMIN_EMAIL=admin@mindtrends.uk
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Administrator
